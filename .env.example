PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# ID of the webhook created at developer.paypal.com → your app → Webhooks (needs a public URL).
# Required at startup; locally, any placeholder works if you don't receive webhooks.
PAYPAL_WEBHOOK_ID=
# sandbox by default; live is https://api-m.paypal.com
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
DATABASE_URL=postgresql://postgres:dev@localhost:5432/postgres
# console.groq.com → API Keys. Required: the app does not start without it.
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
# app.tavily.com → API Keys. Optional: without it, a question with no note gets only PayPal's help link.
# Turn off "Allow Use of Query Data" in the Tavily account (searches are not stored).
TAVILY_API_KEY=
# Groq vision model that reads screenshots. It is a preview model: it can be withdrawn without notice.
VISION_MODEL=qwen/qwen3.8-27b
# Live demo at /demo (sandbox only: the app does not start with DEMO_MODE=true against live PayPal).
# The US sandbox personal account testers pay with; the page shows its email and password.
DEMO_MODE=false
DEMO_BUYER_EMAIL=
DEMO_BUYER_PASSWORD=
# LangSmith: made-up chats only. It sends the chats and replies to LangSmith,
# so never turn it on in Render or with real cases.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=goodtoship-dev
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com  # EU-region account
